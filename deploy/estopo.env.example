# /etc/estopo/estopo.env - settings read at start (see docs/installation.md);
# everything else is set in the administration screens.
# Owner root, group estopo, mode 0640: it may hold a password.

# Address and port. The built-in default is 127.0.0.1:8080 (this machine
# only). Listening on another address with authentication enabled requires
# HTTPS (the two variables below).
ESTOPO_LISTEN=0.0.0.0:8443
ESTOPO_DATA_DIR=/var/lib/estopo

# HTTPS: certificate (full chain accepted) and private key, PEM, readable by
# the estopo user. Restart the service after renewing them.
ESTOPO_TLS_CERT=/etc/estopo/tls/estopo-fullchain.pem
ESTOPO_TLS_KEY=/etc/estopo/tls/estopo.key

ESTOPO_LOG_FORMAT=json

# Every file path typed in the administration (cluster certificates, keys,
# API key and password files, CA, LDAP files) must be inside this directory.
ESTOPO_SECRETS_DIR=/etc/estopo/secrets

# Very first start only: creates the local account "admin" with this password
# (12 characters at least) and enables local authentication. Ignored once an
# account or an authentication mode exists: remove the line after the first
# start. Without it, the instance starts without authentication (every
# visitor is an administrator).
#ESTOPO_ADMIN_PASSWORD=change-me-12-characters-min

# High availability (docs/high-availability.md): the same token file on both
# instances; the CA that signed the certificate of the other instance, on
# both instances, when it is not a system CA; on the standby only, the URL
# of the primary (used at its first start).
#ESTOPO_REPLICATION_TOKEN_FILE=/etc/estopo/replication.token
#ESTOPO_REPLICATION_CA=/etc/estopo/tls/ca.pem
#ESTOPO_STANDBY_OF=https://estopo-a.example.org:8443
